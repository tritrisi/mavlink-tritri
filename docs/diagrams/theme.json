  "flowchart": {
    "htmlLabels": true,
    "curve": "basis",
    "padding": 16,
    "nodeSpacing": 50,
    "rankSpacing": 60
  },
  "sequence": {
    "diagramMarginX": 24,
    "diagramMarginY": 16,
    "actorMargin": 80,
    "width": 180,
    "boxMargin": 10,
    "boxTextMargin": 6,
    "noteMargin": 12,
    "messageMargin": 40
  },
  "state": {
    "nodeSpacing": 50,
    "rankSpacing": 50,
    "padding": 8
  }
}
