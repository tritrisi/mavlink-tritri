{
  "theme": "base",
  "themeVariables": {
    "darkMode": true,
    "background": "#1e1e1e",
    "fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif",
    "fontSize": "14px",
    "primaryColor": "#2d2d2d",
    "primaryTextColor": "#cccccc",
    "primaryBorderColor": "#569cd6",
    "secondaryColor": "#252526",
    "secondaryTextColor": "#cccccc",
    "secondaryBorderColor": "#569cd6",
    "tertiaryColor": "#1e1e1e",
    "tertiaryTextColor": "#cccccc",
    "tertiaryBorderColor": "#569cd6",
    "lineColor": "#858585",
    "textColor": "#cccccc",
    "mainBkg": "#2d2d2d",
    "nodeBorder": "#569cd6",
    "nodeTextColor": "#cccccc",
    "clusterBkg": "#252526",
    "clusterBorder": "#3c3c3c",
    "titleColor": "#cccccc",
    "edgeLabelBackground": "#252526",
    "actorBkg": "#2d2d2d",
    "actorBorder": "#569cd6",
    "actorTextColor": "#cccccc",
    "actorLineColor": "#858585",
    "signalColor": "#cccccc",
    "signalTextColor": "#cccccc",
    "labelBoxBkgColor": "#252526",
    "labelBoxBorderColor": "#569cd6",
    "labelTextColor": "#cccccc",
    "loopTextColor": "#cccccc",
    "noteBkgColor": "#352a00",
    "noteTextColor": "#cccccc",
    "noteBorderColor": "#cca700",
    "activationBkgColor": "#37373d",
    "activationBorderColor": "#569cd6",
    "stateBkg": "#2d2d2d",
    "stateBorder": "#569cd6",
    "labelColor": "#cccccc"
